#!/bin/bash
#PBS -N docking_job
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=24:00:00
#PBS -j oe
#
# Docks every Vina config belonging to one design (e.g. "prot_2_1" ->
# prot_2_1_config.txt, prot_2_1_flex_config.txt,
# prot_2_1_relaxed_0001_config.txt, ...) -- one PBS job per design. A round
# prefix ("prot_2") covers that whole round in a single job instead; see
# scripts/04_run_docking.sh for how PREFIX is matched. Reads/writes directly
# on project storage (no scratch staging), so every job shares the same data/
# directory.
#
# Not meant to be qsub'd directly -- use metacentrum/submit_all.sh, which
# sets PREFIX (and the job name) per design via `qsub -v` / `qsub -N`.
# VINA_EXHAUSTIVENESS, if submit_all.sh forwarded it, is picked up by
# 04_run_docking.sh from the environment.
#
# Configs whose results already exist are skipped (SKIP_EXISTING=1, see
# 04_run_docking.sh), so a job whose design is fully docked exits without
# running Vina, and resubmitting after a walltime kill only docks what's
# missing. Submit with SKIP_EXISTING=0 to force re-docking everything.
set -euo pipefail

: "${PREFIX:?PREFIX must be set, e.g.: qsub -v PREFIX=prot_2_1 run_docking_job.pbs}"
PROJECT_DIR="${PROJECT_DIR:-/storage/praha5-elixir/home/davidhoksza/projects/ancestral-docking}"

module add mambaforge
mamba activate "$PROJECT_DIR/envs/docking"

cd "$PROJECT_DIR"
echo "Host: $(hostname), CPUs allocated: $(nproc), prefix: $PREFIX"

VINA_CPU="${VINA_CPU:-4}" SKIP_EXISTING="${SKIP_EXISTING:-1}" \
    bash scripts/04_run_docking.sh "$PREFIX"
